# This committed file is the complete Niteshift source for the sibling .env.
# Keep only safe local values and unresolved Niteshift references here; resolved
# credentials belong only in the generated, ignored .env and must not be committed.
# Edit this file, then rerun .niteshift/setup to refresh the generated .env.

PORT=3100
API_BASE_URL="http://localhost:8000"

WEB_BASE_URL="${NITESHIFT_PORT_3030_URL}"

LIVE_BASE_URL="${NITESHIFT_PORT_3030_URL}"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="niteshift-dev-only-live-server-secret"

# If you prefer not to provide a Redis URL, you can set the REDIS_HOST and REDIS_PORT environment variables instead.
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL="redis://localhost:6379/"
