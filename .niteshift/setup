#!/usr/bin/env bash
# Niteshift environment setup for Plane.
#
# Everything the browser touches is served from ONE origin (the Caddy proxy on
# :4000), the same way apps/proxy fronts the self-hosted stack:
#
#   /god-mode/*  -> admin dev server   :3001
#   /spaces/*    -> space dev server   :3002
#   /live/*      -> live server        :3100
#   /api|/auth|/static/* -> Django API :8000
#   /uploads/*   -> MinIO              :9000
#   /*           -> web dev server     :3000
#
# A single origin keeps Plane's session and CSRF cookies working inside the
# preview iframe and lets the frontends run with relative API base URLs.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PROXY_PORT=4000
# Niteshift injects the preview URL once services.yaml is committed; fall back to
# localhost so the very first run (and any local run) still works.
PROXY_ORIGIN="${NITESHIFT_PORT_4000_URL:-http://localhost:${PROXY_PORT}}"
# MinIO presigns upload URLs with the scheme the browser has to use.
case "$PROXY_ORIGIN" in
  https://*) MINIO_SSL=1 ;;
  *) MINIO_SSL=0 ;;
esac
BROWSER_ORIGINS="$PROXY_ORIGIN"
if [ "$PROXY_ORIGIN" != "http://localhost:${PROXY_PORT}" ]; then
  BROWSER_ORIGINS="${PROXY_ORIGIN},http://localhost:${PROXY_PORT}"
fi

echo "==> Plane setup — browser origin: ${PROXY_ORIGIN}"

# --------------------------------------------------------------------- env
# Dev-only credentials. They unlock a Postgres, Valkey, RabbitMQ and MinIO that
# are created inside this sandbox and die with it, so they are fixed literals:
# regenerating them on every run would invalidate sessions and stored data.
DEV_SECRET_KEY="niteshift-dev-only-django-secret-key-plane"
LIVE_SECRET_KEY="niteshift-dev-only-live-secret-key"

echo "--> writing env files"

cat > .env <<EOF
# Generated by .niteshift/setup — sandbox values, not committed.
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
USE_MINIO=1
EOF

cat > apps/api/.env <<EOF
# Generated by .niteshift/setup — sandbox values, not committed.
DEBUG=1
CORS_ALLOWED_ORIGINS="${BROWSER_ORIGINS}"
SECRET_KEY="${DEV_SECRET_KEY}"

# Containers run with host networking, so every dependency is on localhost.
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="localhost"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://plane:plane@localhost:5432/plane"

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/"

RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
USE_MINIO=1
MINIO_ENDPOINT_SSL=${MINIO_SSL}

# Every browser-facing URL is the proxy origin; paths do the routing.
WEB_URL="${PROXY_ORIGIN}"
APP_BASE_URL="${PROXY_ORIGIN}"
APP_BASE_PATH=""
ADMIN_BASE_URL="${PROXY_ORIGIN}"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="${PROXY_ORIGIN}"
SPACE_BASE_PATH="/spaces"
LIVE_BASE_URL="${PROXY_ORIGIN}"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="${LIVE_SECRET_KEY}"

GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT="60/minute"
EOF

# The three Vite apps talk to the API through the proxy, so their base URLs are
# empty (@plane/constants falls back to same-origin relative requests).
for app in web admin space; do
  cat > "apps/${app}/.env" <<EOF
# Generated by .niteshift/setup — sandbox values, not committed.
VITE_API_BASE_URL=""

VITE_WEB_BASE_URL=""

VITE_ADMIN_BASE_URL=""
VITE_ADMIN_BASE_PATH="/god-mode"

VITE_SPACE_BASE_URL=""
VITE_SPACE_BASE_PATH="/spaces"

VITE_LIVE_BASE_URL=""
VITE_LIVE_BASE_PATH="/live"
EOF
done

cat > apps/live/.env <<EOF
# Generated by .niteshift/setup — sandbox values, not committed.
PORT=3100
API_BASE_URL="http://localhost:8000"
CORS_ALLOWED_ORIGINS="${BROWSER_ORIGINS}"

WEB_BASE_URL="${PROXY_ORIGIN}"
LIVE_BASE_URL="${PROXY_ORIGIN}"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="${LIVE_SECRET_KEY}"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/"
EOF

# ------------------------------------------------------- generated overrides
# Docker bridge networking is disabled in the sandbox, so every container runs
# with host networking. The project's compose file stays untouched; this
# override adapts it and is never committed.
echo "--> writing docker-compose.niteshift.yml and Caddyfile.niteshift"

cat > docker-compose.niteshift.yml <<'EOF'
# Generated by .niteshift/setup — do not commit.
# Host networking for every container: the sandbox runs Docker with
# --iptables=false, so bridge networks cannot route.
services:
  plane-redis:
    network_mode: host
    ports: !reset null
    networks: !reset null
  plane-mq:
    network_mode: host
    ports: !reset null
    networks: !reset null
  plane-minio:
    network_mode: host
    ports: !reset null
    networks: !reset null
  plane-db:
    network_mode: host
    ports: !reset null
    networks: !reset null
  api:
    network_mode: host
    build:
      network: host
    ports: !reset null
    networks: !reset null
  worker:
    network_mode: host
    build:
      network: host
    networks: !reset null
  beat-worker:
    network_mode: host
    build:
      network: host
    networks: !reset null
  migrator:
    network_mode: host
    build:
      network: host
    networks: !reset null
networks: !reset null
EOF

cat > Caddyfile.niteshift <<EOF
# Generated by .niteshift/setup — do not commit.
{
	admin off
	auto_https off
	servers {
		max_header_size 25MB
		trusted_proxies static 0.0.0.0/0
	}
}

:${PROXY_PORT} {
	request_body {
		max_size 5MB
	}

	# The preview panel embeds the app in an iframe on niteshift.dev.
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' https://niteshift.dev https://*.niteshift.dev"
	}

	redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* localhost:3002 {
		header_up Host {upstream_hostport}
	}

	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* localhost:3001 {
		header_up Host {upstream_hostport}
	}

	reverse_proxy /live/* localhost:3100
	reverse_proxy /api/* localhost:8000
	reverse_proxy /auth/* localhost:8000
	reverse_proxy /static/* localhost:8000
	reverse_proxy /uploads localhost:9000
	reverse_proxy /uploads/* localhost:9000

	# Vite rejects unknown Host headers, so the dev servers see localhost.
	reverse_proxy /* localhost:3000 {
		header_up Host {upstream_hostport}
	}
}
EOF

# Keep the working tree clean: the generated files are sandbox-only.
for f in docker-compose.niteshift.yml Caddyfile.niteshift; do
  grep -qxF "/${f}" .git/info/exclude 2>/dev/null || echo "/${f}" >> .git/info/exclude
done

# -------------------------------------------------------------- javascript
echo "--> installing node dependencies"
corepack enable pnpm
pnpm install --frozen-lockfile

# turbo's dev task depends on ^build, so warm the workspace package builds here
# rather than on every service start.
echo "--> building workspace packages"
pnpm turbo run build --filter="./packages/*"

# ------------------------------------------------------------------ docker
echo "--> pulling and building backend images"
docker pull -q caddy:2-alpine
docker compose -f docker-compose-local.yml -f docker-compose.niteshift.yml pull --ignore-buildable -q
docker compose -f docker-compose-local.yml -f docker-compose.niteshift.yml build

echo "==> setup complete"
