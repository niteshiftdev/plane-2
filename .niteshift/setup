#!/usr/bin/env bash
# Niteshift one-shot setup for the Plane monorepo.
#
# Topology (see .niteshift/services.yaml):
#   backend  — docker-compose-local.yml: postgres, valkey, rabbitmq, minio, api, worker, beat
#   frontend — pnpm dev: web (3000), admin (3001), space (3002), live (3100)
#   proxy    — Caddy on 4000, the single browser origin that fronts all of the above
#
# The proxy exists because the browser that views the preview is outside the sandbox
# and cannot reach sandbox localhost. Serving every app and the API from one origin
# keeps API calls, session cookies and MinIO URLs relative, exactly like the Caddy
# proxy Plane ships for self-hosted deployments (apps/proxy/Caddyfile.ce).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# The one browser-facing origin. NITESHIFT_PORT_4000_URL is injected on tasks that
# start after services.yaml is committed; fall back to localhost otherwise.
PROXY_PORT=4000
BASE_URL="${NITESHIFT_PORT_4000_URL:-http://localhost:${PROXY_PORT}}"

# Fixed dev-only values. They are scoped to the sandbox and must stay stable across
# setup reruns and resumes — regenerating them would invalidate existing sessions.
DEV_SECRET_KEY="niteshift-plane-dev-secret-key-not-for-production"
DEV_LIVE_SERVER_SECRET_KEY="niteshift-plane-dev-live-secret-key"

echo "==> Generating .env files and installing node dependencies (./setup.sh)"
./setup.sh

echo "==> Applying Niteshift dev overrides to apps/api/.env"
# Appended last: docker compose env_file keeps the final assignment of a key, so these
# override the values ./setup.sh copied out of apps/api/.env.example — including the
# random SECRET_KEY it appends, which would otherwise change on every setup run.
#
# CORS_ALLOWED_ORIGINS drives both CSRF_TRUSTED_ORIGINS and the cookie "secure" flags
# in apps/api/plane/settings/common.py. Keeping the http:// localhost origin in the
# list is what keeps session/CSRF cookies non-Secure, so verification over plain http
# on localhost works while the https preview origin is still trusted for CSRF.
CORS_ALLOWED_ORIGINS="http://localhost:${PROXY_PORT}"
if [ "$BASE_URL" != "http://localhost:${PROXY_PORT}" ]; then
  CORS_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS},${BASE_URL}"
fi

cat >> apps/api/.env <<EOF

# ---- Niteshift dev overrides (last assignment wins) ----
SECRET_KEY="${DEV_SECRET_KEY}"
LIVE_SERVER_SECRET_KEY="${DEV_LIVE_SERVER_SECRET_KEY}"
CORS_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS}"
# Browser-facing base URLs: auth redirects, invite links and the MinIO custom domain
# (AWS_S3_CUSTOM_DOMAIN is derived from WEB_URL) all have to resolve in the viewer's
# browser, so they point at the proxy origin rather than at a sandbox-local port.
WEB_URL="${BASE_URL}"
APP_BASE_URL="${BASE_URL}"
APP_BASE_PATH=""
ADMIN_BASE_URL="${BASE_URL}"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="${BASE_URL}"
SPACE_BASE_PATH="/spaces"
# Server-side only: bgtasks call the live server directly from the api container.
LIVE_BASE_URL="http://host.docker.internal:3100"
LIVE_BASE_PATH="/live"
# Serve uploads through the proxy (/uploads) instead of a separate MinIO origin.
USE_MINIO=1
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
EOF

echo "==> Writing single-origin frontend .env files"
# Empty base URLs make @plane/constants build relative URLs (endpoints.ts falls back
# to ""), so every app talks to whichever origin served it — localhost or the preview.
for app in web admin space; do
  cat > "apps/${app}/.env" <<'EOF'
# Managed by .niteshift/setup — every base URL is relative so the apps and the API
# are reached through the single Caddy origin declared in .niteshift/services.yaml.
VITE_API_BASE_URL=""
VITE_WEB_BASE_URL=""
VITE_ADMIN_BASE_URL=""
VITE_ADMIN_BASE_PATH="/god-mode"
VITE_SPACE_BASE_URL=""
VITE_SPACE_BASE_PATH="/spaces"
VITE_LIVE_BASE_URL=""
VITE_LIVE_BASE_PATH="/live"
EOF
done

echo "==> Writing apps/live/.env"
cat > apps/live/.env <<EOF
# Managed by .niteshift/setup — the live server runs on the host and reaches the
# containerised api and redis through the ports docker-compose-local.yml publishes.
PORT=3100
API_BASE_URL="http://localhost:8000"
WEB_BASE_URL="${BASE_URL}"
LIVE_BASE_URL="${BASE_URL}"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="${DEV_LIVE_SERVER_SECRET_KEY}"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/"
EOF

echo "==> Writing docker-compose.niteshift.yml"
# Adaptations to docker-compose-local.yml: the supervisor owns the container
# lifecycle, so no container may carry a restart policy, and the api-side
# containers need a route back to the live server running on the host.
cat > docker-compose.niteshift.yml <<'EOF'
# Generated by .niteshift/setup. Not tracked by git.
services:
  plane-redis:
    restart: "no"
  plane-mq:
    restart: "no"
  plane-minio:
    restart: "no"
  plane-db:
    restart: "no"
  api:
    restart: "no"
    extra_hosts:
      - "host.docker.internal:host-gateway"
  worker:
    restart: "no"
    extra_hosts:
      - "host.docker.internal:host-gateway"
  beat-worker:
    restart: "no"
    extra_hosts:
      - "host.docker.internal:host-gateway"
  migrator:
    extra_hosts:
      - "host.docker.internal:host-gateway"
EOF

echo "==> Writing Caddyfile.niteshift"
# Mirrors apps/proxy/Caddyfile.ce, pointed at the dev servers instead of containers.
cat > Caddyfile.niteshift <<'EOF'
# Generated by .niteshift/setup. Not tracked by git.
{
	# 2019 is reserved by the sandbox, and no certificates are needed behind the
	# Niteshift preview gateway.
	admin off
	auto_https off
}

:{$PORT:4000} {
	request_body {
		max_size 5MB
	}

	# The preview panel embeds the app in an iframe on niteshift.dev.
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' https://niteshift.dev https://*.niteshift.dev"
	}

	# Django. Preview hostnames embed the task id, which may contain an
	# underscore (ns-4000-int_abc123.preview.niteshift.dev); Django rejects such a
	# Host outright with DisallowedHost, before ALLOWED_HOSTS is even consulted.
	# Present the proxy's own localhost origin instead. The real browser origin is
	# still trusted for CSRF through CORS_ALLOWED_ORIGINS in apps/api/.env.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host localhost:{$PORT:4000}
		}
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host localhost:{$PORT:4000}
		}
	}
	handle /static/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host localhost:{$PORT:4000}
		}
	}

	# MinIO, addressed as {origin}/uploads. Presigned URLs are signed against the
	# host Django saw, so hand MinIO that same host and the signature verifies
	# whichever origin the browser used to reach the proxy.
	handle /uploads/* {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host localhost:{$PORT:4000}
		}
	}

	# Vite rejects Host headers it does not know and its allowlist is only
	# configurable in the tracked vite.config.ts files, so present the upstream's
	# own host:port to the dev servers instead.
	redir /god-mode /god-mode/ permanent
	handle /god-mode/* {
		reverse_proxy 127.0.0.1:3001 {
			header_up Host {upstream_hostport}
		}
	}

	redir /spaces /spaces/ permanent
	handle /spaces/* {
		reverse_proxy 127.0.0.1:3002 {
			header_up Host {upstream_hostport}
		}
	}

	handle /live/* {
		reverse_proxy 127.0.0.1:3100 {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {upstream_hostport}
		}
	}
}
EOF

echo "==> Excluding generated files from git"
touch .git/info/exclude
for generated in docker-compose.niteshift.yml Caddyfile.niteshift; do
  grep -qxF "$generated" .git/info/exclude || echo "$generated" >> .git/info/exclude
done

echo "==> Building workspace packages (turbo dev depends on them)"
pnpm turbo run build --filter='./packages/*'

echo "==> Building the api container image"
docker compose -f docker-compose-local.yml -f docker-compose.niteshift.yml build

echo "==> Pulling the infrastructure images"
# Without this the backend service spends its first minutes pulling postgres,
# valkey, rabbitmq and minio instead of serving.
docker compose -f docker-compose-local.yml -f docker-compose.niteshift.yml pull --ignore-buildable

echo "==> Setup complete. Open ${BASE_URL}"
