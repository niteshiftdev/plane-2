#!/usr/bin/env bash
# One-shot preparation of a fresh Niteshift sandbox for Plane.
#
# Long-running processes live in .niteshift/services.yaml:
#   stack -> docker compose (postgres, valkey, rabbitmq, minio, api, worker,
#            beat, migrator, caddy proxy on :4000)
#   apps  -> pnpm dev (turbo: web :3000, admin :3001, space :3002, live :3100)
#
# Everything the browser touches is served through the Caddy proxy on :4000, so
# the whole product is reachable from one preview URL and stays same-origin.
set -euo pipefail

cd "$(dirname "$0")/.."

PREVIEW_PORT=4000
BASE_URL="${NITESHIFT_PORT_4000_URL:-http://localhost:${PREVIEW_PORT}}"
COMPOSE_FILES=(-f docker-compose-local.yml -f docker-compose.niteshift.yml)

log() { printf '\n==> %s\n' "$*"; }

# Set KEY="value" in an env file, replacing an existing entry or appending.
set_env() {
  local file=$1 key=$2 value=$3
  touch "$file"
  if grep -qE "^${key}=" "$file"; then
    sed -i -E "s|^${key}=.*|${key}=\"${value}\"|" "$file"
  else
    printf '%s="%s"\n' "$key" "$value" >>"$file"
  fi
}

# Keep generated, sandbox-only files out of `git status`.
git_exclude() {
  local pattern=$1
  local exclude_file=.git/info/exclude
  mkdir -p "$(dirname "$exclude_file")"
  touch "$exclude_file"
  grep -qxF "$pattern" "$exclude_file" || printf '%s\n' "$pattern" >>"$exclude_file"
}

# --------------------------------------------------------------------------
# 1. Env files and node dependencies
# --------------------------------------------------------------------------
# The repo's setup.sh copies every .env.example over its .env and regenerates
# the Django SECRET_KEY, so only run it when the env files are still missing.
if [ ! -f apps/api/.env ]; then
  log "Generating .env files and installing node dependencies (./setup.sh)"
  ./setup.sh
else
  log "Installing node dependencies"
  corepack enable pnpm
  pnpm install --frozen-lockfile
fi

# --------------------------------------------------------------------------
# 2. Point every service at the sandbox topology
# --------------------------------------------------------------------------
# Docker bridge networking is disabled in the sandbox, so every container runs
# with host networking and reaches its peers on localhost instead of by
# compose service name.
log "Rewriting .env files for host networking and ${BASE_URL}"

# Root .env is the compose project env file; it also supplies the values that
# compose interpolates into apps/api/.env (REDIS_URL, DATABASE_URL, ...).
set_env .env REDIS_HOST localhost
set_env .env RABBITMQ_HOST localhost
set_env .env POSTGRES_HOST localhost

set_env apps/api/.env POSTGRES_HOST localhost
set_env apps/api/.env REDIS_HOST localhost
set_env apps/api/.env RABBITMQ_HOST localhost
set_env apps/api/.env AWS_S3_ENDPOINT_URL "http://localhost:9000"
# Serve uploads through the proxy origin instead of a direct MinIO host.
set_env apps/api/.env USE_MINIO 1
case "$BASE_URL" in
https://*) set_env apps/api/.env MINIO_ENDPOINT_SSL 1 ;;
*) set_env apps/api/.env MINIO_ENDPOINT_SSL 0 ;;
esac
# Redirect targets Django hands to the browser, plus CSRF/CORS trust. Keeping
# an http:// origin in the list turns off Secure cookies so the stack also
# works over http://localhost:4000 from inside the sandbox.
set_env apps/api/.env WEB_URL "$BASE_URL"
set_env apps/api/.env APP_BASE_URL "$BASE_URL"
set_env apps/api/.env ADMIN_BASE_URL "$BASE_URL"
set_env apps/api/.env SPACE_BASE_URL "$BASE_URL"
set_env apps/api/.env LIVE_BASE_URL "$BASE_URL"
LOCAL_ORIGIN="http://localhost:${PREVIEW_PORT}"
if [ "$BASE_URL" = "$LOCAL_ORIGIN" ]; then
  set_env apps/api/.env CORS_ALLOWED_ORIGINS "$LOCAL_ORIGIN"
else
  set_env apps/api/.env CORS_ALLOWED_ORIGINS "${BASE_URL},${LOCAL_ORIGIN}"
fi

# Frontends: empty API base URL keeps every request same-origin through the proxy.
for app in web admin space; do
  set_env "apps/${app}/.env" VITE_API_BASE_URL ""
  set_env "apps/${app}/.env" VITE_WEB_BASE_URL "$BASE_URL"
  set_env "apps/${app}/.env" VITE_ADMIN_BASE_URL "$BASE_URL"
  set_env "apps/${app}/.env" VITE_SPACE_BASE_URL "$BASE_URL"
  set_env "apps/${app}/.env" VITE_LIVE_BASE_URL "$BASE_URL"
done

set_env apps/live/.env API_BASE_URL "http://localhost:8000"
set_env apps/live/.env WEB_BASE_URL "$BASE_URL"
set_env apps/live/.env LIVE_BASE_URL "$BASE_URL"
set_env apps/live/.env REDIS_HOST localhost
set_env apps/live/.env REDIS_URL "redis://localhost:6379/"

# --------------------------------------------------------------------------
# 3. Compose override for the sandbox
# --------------------------------------------------------------------------
# docker-compose-local.yml is left untouched; this override drops the bridge
# network and published-port mappings, builds with host networking, and adds
# the Caddy proxy that fronts the whole stack on :4000.
log "Writing docker-compose.niteshift.yml"
cat >docker-compose.niteshift.yml <<'YAML'
# Generated by .niteshift/setup - do not edit, do not commit.
# Adapts docker-compose-local.yml to the Niteshift sandbox, where Docker runs
# with --iptables=false and bridge networking does not work.
services:
  plane-db: { network_mode: host, ports: !reset null, networks: !reset null }
  plane-redis: { network_mode: host, ports: !reset null, networks: !reset null }
  plane-mq: { network_mode: host, ports: !reset null, networks: !reset null }
  plane-minio: { network_mode: host, ports: !reset null, networks: !reset null }
  api: { network_mode: host, ports: !reset null, networks: !reset null, build: { network: host } }
  worker: { network_mode: host, ports: !reset null, networks: !reset null, build: { network: host } }
  beat-worker: { network_mode: host, ports: !reset null, networks: !reset null, build: { network: host } }
  migrator: { network_mode: host, ports: !reset null, networks: !reset null, build: { network: host } }

  niteshift-proxy:
    image: caddy:2.11.3-alpine
    restart: unless-stopped
    network_mode: host
    command: caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
    env_file:
      - .env
    volumes:
      - ./.niteshift/Caddyfile:/etc/caddy/Caddyfile:ro

networks: !reset null
YAML
git_exclude docker-compose.niteshift.yml

# --------------------------------------------------------------------------
# 4. Build
# --------------------------------------------------------------------------
log "Building Docker images"
docker compose "${COMPOSE_FILES[@]}" build
docker compose "${COMPOSE_FILES[@]}" pull --quiet --ignore-buildable

# `turbo run dev` depends on ^build, so the shared packages have to be compiled
# before the app dev servers can resolve them. Doing it here keeps the `apps`
# service from spending its first minute building.
log "Building workspace packages"
pnpm turbo run build --filter="./packages/*"

log "Setup complete - services start from .niteshift/services.yaml"
