#!/usr/bin/env bash
# Niteshift environment setup for Plane.
#
# Mirrors the documented local workflow (./setup.sh -> docker compose -f
# docker-compose-local.yml up -> pnpm dev) with two Niteshift adaptations:
#   * every app is served from a single origin by a Caddy reverse proxy so the
#     preview panel needs only one port, and
#   * the instance is pre-configured with a dev user, workspace and sample data.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Also declared in .niteshift/Caddyfile.niteshift and .niteshift/services.yaml.
PREVIEW_PORT=3030
# NITESHIFT_PORT_3030_URL only exists once the manifest is committed; fall back
# to localhost so the very first task still renders a coherent instance.
BASE_ORIGIN="${NITESHIFT_PORT_3030_URL:-http://localhost:${PREVIEW_PORT}}"
COMPOSE=(docker compose -f docker-compose-local.yml -f .niteshift/docker-compose.niteshift.yml)

# Dev-only secrets. They sign nothing outside this sandbox's own database, and
# they are deliberately fixed so sessions survive setup re-runs and resumes.
DJANGO_SECRET_KEY="niteshift-dev-only-django-secret-key-not-for-production"
LIVE_SECRET_KEY="niteshift-dev-only-live-server-secret"

DEV_EMAIL="dev@plane.local"
DEV_PASSWORD="Plane@12345"
DEV_WORKSPACE="dev-workspace"

CORS_ORIGINS="$BASE_ORIGIN"
if [ "$BASE_ORIGIN" != "http://localhost:${PREVIEW_PORT}" ]; then
  CORS_ORIGINS="${BASE_ORIGIN},http://localhost:${PREVIEW_PORT}"
fi

# Render <app>/.env from the tracked .env.example, dropping the keys we override
# so newly added upstream variables keep their defaults.
write_env() {
  local example="$1" out="$2" overrides="$3" keys
  keys=$(printf '%s\n' "$overrides" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | paste -sd'|' -)
  grep -Ev "^[[:space:]]*(${keys})[[:space:]]*=" "$example" > "$out"
  printf '\n# --- Niteshift overrides ---\n%s\n' "$overrides" >> "$out"
}

echo "==> Rendering environment files (origin: ${BASE_ORIGIN})"

cp .niteshift/.env.niteshift .env

# Every browser-facing URL is relative: the proxy serves web, admin, space, live
# and the API from one origin, exactly like the self-hosted proxy deployment.
FRONTEND_ENV='VITE_API_BASE_URL=""
VITE_WEB_BASE_URL=""
VITE_WEB_BASE_PATH=""
VITE_ADMIN_BASE_URL=""
VITE_ADMIN_BASE_PATH="/god-mode"
VITE_SPACE_BASE_URL=""
VITE_SPACE_BASE_PATH="/spaces"
VITE_LIVE_BASE_URL=""
VITE_LIVE_BASE_PATH="/live"'
for app in web admin space; do
  write_env "apps/${app}/.env.example" "apps/${app}/.env" "$FRONTEND_ENV"
done

write_env apps/live/.env.example apps/live/.env "PORT=3100
API_BASE_URL=\"http://localhost:8000\"
WEB_BASE_URL=\"${BASE_ORIGIN}\"
LIVE_BASE_URL=\"${BASE_ORIGIN}\"
LIVE_BASE_PATH=\"/live\"
LIVE_SERVER_SECRET_KEY=\"${LIVE_SECRET_KEY}\"
REDIS_HOST=\"localhost\"
REDIS_PORT=6379
REDIS_URL=\"redis://localhost:6379/\""

# The API redirects the browser to absolute URLs after sign-in and builds
# presigned upload URLs from the request host, so it needs the preview origin.
write_env apps/api/.env.example apps/api/.env "DEBUG=1
SECRET_KEY=\"${DJANGO_SECRET_KEY}\"
CORS_ALLOWED_ORIGINS=\"${CORS_ORIGINS}\"
POSTGRES_HOST=\"plane-db\"
DATABASE_URL=\"postgresql://plane:plane@plane-db:5432/plane\"
REDIS_HOST=\"plane-redis\"
REDIS_URL=\"redis://plane-redis:6379/\"
USE_MINIO=0
AWS_S3_ENDPOINT_URL=\"http://plane-minio:9000\"
WEB_URL=\"${BASE_ORIGIN}\"
APP_BASE_URL=\"${BASE_ORIGIN}\"
APP_BASE_PATH=\"\"
ADMIN_BASE_URL=\"\"
ADMIN_BASE_PATH=\"/god-mode\"
SPACE_BASE_URL=\"\"
SPACE_BASE_PATH=\"/spaces\"
LIVE_BASE_URL=\"${BASE_ORIGIN}\"
LIVE_BASE_PATH=\"/live\"
LIVE_SERVER_SECRET_KEY=\"${LIVE_SECRET_KEY}\""

echo "==> Installing node dependencies"
corepack enable pnpm
pnpm install --frozen-lockfile

echo "==> Building workspace packages"
# turbo run dev depends on ^build; pre-building keeps the dev servers fast to start.
pnpm turbo run build --filter='./packages/*'

echo "==> Building the API image"
"${COMPOSE[@]}" build

echo "==> Starting the backend stack"
ns services start plane-backend
curl -sf --retry 90 --retry-delay 2 --retry-connrefused --retry-all-errors \
  -o /dev/null http://localhost:8000/api/instances/

echo "==> Seeding the instance"
"${COMPOSE[@]}" exec -T \
  -e SEED_EMAIL="$DEV_EMAIL" -e SEED_PASSWORD="$DEV_PASSWORD" -e SEED_WORKSPACE="$DEV_WORKSPACE" \
  api python manage.py shell --settings=plane.settings.local \
  < .niteshift/scripts/seed-dev-instance.py

echo "==> Minting a preview session"
DEV_EMAIL="$DEV_EMAIL" DEV_PASSWORD="$DEV_PASSWORD" \
  .niteshift/scripts/mint-preview-session

echo "==> Setup complete"
