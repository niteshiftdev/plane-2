#!/usr/bin/env bash
# Runs on every resume, before services are reconciled.
#
# Everything setup produced (env files, images, node_modules, the Postgres
# volume) survives suspension. Plane sessions do not: SESSION_COOKIE_AGE is
# seven days, so re-mint the session that signs preview viewers in.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

DEV_EMAIL="dev@plane.local"
DEV_PASSWORD="Plane@12345"

echo "==> Waiting for the backend stack"
ns services start plane-backend
if ! curl -sf --retry 60 --retry-delay 2 --retry-connrefused --retry-all-errors \
  -o /dev/null http://localhost:8000/api/instances/; then
  echo "    WARNING: API did not answer; sign in as ${DEV_EMAIL} / ${DEV_PASSWORD}"
  exit 0
fi

echo "==> Re-minting the preview session"
JAR=$(mktemp)
trap 'rm -f "$JAR"' EXIT
CSRF=$(curl -s -c "$JAR" http://localhost:8000/auth/get-csrf-token/ |
  sed -n 's/.*"csrf_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
curl -s -o /dev/null -b "$JAR" -c "$JAR" -X POST http://localhost:8000/auth/sign-in/ \
  -H "Referer: http://localhost:8000/" \
  --data-urlencode "csrfmiddlewaretoken=${CSRF}" \
  --data-urlencode "email=${DEV_EMAIL}" \
  --data-urlencode "password=${DEV_PASSWORD}"
SESSION=$(awk '$6 == "session-id" { print $7 }' "$JAR")

if [ -n "$SESSION" ]; then
  mkdir -p /root/.niteshift/agent-browser
  printf '%s\n' task-provisioned > /root/.niteshift/agent-browser/auth-strategy
  cat > /tmp/agent-browser-state.json <<STATE
{
  "cookies": [
    {
      "name": "session-id",
      "value": "${SESSION}",
      "domain": "localhost",
      "path": "/",
      "httpOnly": true,
      "secure": false,
      "sameSite": "Lax"
    }
  ],
  "origins": []
}
STATE
  echo "    preview viewers are signed in as ${DEV_EMAIL}"
else
  echo "    WARNING: could not mint a session; sign in as ${DEV_EMAIL} / ${DEV_PASSWORD}"
fi
